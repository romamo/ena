# Copy to .env and fill in. Never commit .env
# From sandbox.bankofcyprus.com > My Apps (the secret is shown once)
BOC_CLIENT_ID=
BOC_CLIENT_SECRET=
# Must match the redirect URI registered on the app
BOC_REDIRECT_URI=https://localhost/callback
BOC_API_BASE=https://sandbox-apis.bankofcyprus.com/df-boc-org-sb/sb/psd2
BOC_SIGN_URL=https://sandbox-apis.bankofcyprus.com/df-boc-org-sb/sb/jwssignverifyapi/sign
# Printed by `uv run ena-boc activate`; valid about 180 days
BOC_SUBSCRIPTION_ID=
