# Copy to .env and fill in. Never commit .env
# From sandbox.bankofcyprus.com > My Apps (the secret is shown once)
BOC_CLIENT_ID=
BOC_CLIENT_SECRET=
# Must match the redirect URI registered on the app
BOC_REDIRECT_URI=https://localhost/
BOC_API_BASE=https://sandbox-apis.bankofcyprus.com/df-boc-org-sb/sb/psd2
BOC_SIGN_URL=https://sandbox-apis.bankofcyprus.com/df-boc-org-sb/sb/jwssignverifyapi/sign
# Printed by `uv run ena-boc activate`; valid about 180 days
BOC_SUBSCRIPTION_ID=

# Jinius integration environment: Settings > Developer in the portal
# The API host; its own /oauth/token issues the token (the portal's Keycloak token is refused)
JINIUS_BASE_URL=https://api.integration.platform.cy
JINIUS_CLIENT_ID=
JINIUS_CLIENT_SECRET=
# Ena Flour Mill Ltd (the supplier): approved, but no API client yet
JINIUS_SUPPLIER_CLIENT_ID=
JINIUS_SUPPLIER_CLIENT_SECRET=

# JCC sandbox: the API user (login ends in -api) and Settings > Merchant > Webhooks in the test portal
JCC_BASE_URL=https://gateway-test.jcc.com.cy/payment/rest/
JCC_API_USER=
JCC_API_PASSWORD=
# Without it, `ena-serve` refuses every callback; with it, the user and password are required too
JCC_CALLBACK_SECRET=

# The chat agent (ena/agent.py): Claude through the Claude Agent SDK
# Its credential is ANTHROPIC_API_KEY in the shell's environment (or a `claude` login), not here
# `ena-serve` needs ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN there; without, /chat answers an error
ENA_MODEL=claude-opus-5-5
# The most model turns one owner message may take
ENA_MAX_TURNS=12
